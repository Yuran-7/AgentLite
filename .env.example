# AgentLite 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
AGENTLITE_HOST=127.0.0.1
AGENTLITE_PORT=7437

# ── Session Storage ───────────────────────────────────────────
# 默认写入用户目录，并按 YYYY/MM/DD/<session-id> 分层保存
AGENTLITE_SESSIONS_DIR=~/.agentlite/sessions

# ── Logging ───────────────────────────────────────────────────
AGENTLITE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
AGENTLITE_LOG_FILE=~/.agentlite/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
AGENTLITE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# AGENTLITE_CONFIG=~/.agentlite/config.toml

# ── LLM ──────────────────────────────────────────────────────
# 只切换这一项即可选择 DeepSeek 服务使用的 API 协议
LLM_PROTOCOL=anthropic
LLM_DEFAULT_MODEL=deepseek-chat

# Anthropic-compatible 协议；base URL 留空时使用 Anthropic SDK 默认地址
# ANTHROPIC_BASE_URL=https://example.com
# ANTHROPIC_API_KEY=...

# OpenAI-compatible 协议；base URL 通常包含 /v1
# OPENAI_BASE_URL=https://example.com/v1
# OPENAI_API_KEY=...

# 可选的通用覆盖；设置后优先于上面对应协议的标准变量
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=...
# AGENTLITE_MAX_STEPS=20

# ── Web tools ────────────────────────────────────────────────
# AGENTLITE_WEB_ENABLED=true
# AGENTLITE_WEB_SEARCH_PROVIDER=duckduckgo  # duckduckgo | brave | searxng
# AGENTLITE_WEB_SEARCH_API_KEY=             # Brave 时填写
# AGENTLITE_WEB_SEARCH_BASE_URL=            # SearXNG 时填写
# AGENTLITE_BROWSER_ENABLED=true
# AGENTLITE_BROWSER_HEADLESS=true
# 登录/验证码等待用户接管时，浏览器会跨轮保留；空闲超过该秒数后自动关闭
# AGENTLITE_BROWSER_IDLE_TIMEOUT_S=600

# 子 Agent 默认不含 web_search、web_fetch、browser；按需显式加入
# AGENTLITE_SUBAGENT_ALLOWED_TOOLS=read_file,shell,write_file,list_dir,update_plan,spawn_agent,agent_result
