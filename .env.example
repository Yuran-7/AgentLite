# KamaClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
KAMA_HOST=127.0.0.1
KAMA_PORT=7437

# ── Session Storage ───────────────────────────────────────────
# 相对路径以启动 kama-core 时的当前目录为基准
KAMA_SESSIONS_DIR=.kama/sessions

# ── Logging ───────────────────────────────────────────────────
KAMA_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
KAMA_LOG_FILE=~/.kama/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
KAMA_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# KAMA_CONFIG=~/.kama/config.toml

# ── LLM ──────────────────────────────────────────────────────
# 只切换这一项即可选择 DeepSeek 服务使用的 API 协议
LLM_PROTOCOL=anthropic
LLM_DEFAULT_MODEL=deepseek-chat

# Anthropic-compatible 协议；base URL 留空时使用 Anthropic SDK 默认地址
# ANTHROPIC_BASE_URL=https://example.com
# ANTHROPIC_API_KEY=...

# OpenAI-compatible 协议；base URL 通常包含 /v1
# OPENAI_BASE_URL=https://example.com/v1
# OPENAI_API_KEY=...

# 可选的通用覆盖；设置后优先于上面对应协议的标准变量
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=...
# KAMA_MAX_STEPS=20

# ── Web tools ────────────────────────────────────────────────
# KAMA_WEB_ENABLED=true
# KAMA_WEB_SEARCH_PROVIDER=duckduckgo  # duckduckgo | brave | searxng
# KAMA_WEB_SEARCH_API_KEY=             # Brave 时填写
# KAMA_WEB_SEARCH_BASE_URL=            # SearXNG 时填写
# KAMA_BROWSER_ENABLED=true
# KAMA_BROWSER_HEADLESS=true
# 登录/验证码等待用户接管时，浏览器会跨轮保留；空闲超过该秒数后自动关闭
# KAMA_BROWSER_IDLE_TIMEOUT_S=600

# 子 Agent 默认不含 web_search、web_fetch、browser；按需显式加入
# KAMA_SUBAGENT_ALLOWED_TOOLS=read_file,shell,write_file,list_dir,task_create,task_update,task_list,task_get,spawn_agent,agent_result
